{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "profile": {
      "const": 5
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "space_id": {
      "type": "string",
      "format": "uuid"
    },
    "operation": {
      "enum": [
        "append",
        "revise"
      ]
    },
    "memory_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "primary_evidence_id": {
      "type": "string",
      "format": "uuid"
    },
    "content_payload_id": {
      "type": "string",
      "format": "uuid"
    },
    "idempotency_key": {
      "type": "string",
      "format": "uuid"
    },
    "validity": {
      "$ref": "time.schema.json"
    }
  },
  "required": [
    "profile",
    "tenant_id",
    "space_id",
    "operation",
    "memory_id",
    "expected_version",
    "evidence_ids",
    "primary_evidence_id",
    "content_payload_id",
    "idempotency_key",
    "validity"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "append"
          }
        }
      },
      "then": {
        "properties": {
          "memory_id": {
            "type": "null"
          },
          "expected_version": {
            "const": 0
          }
        }
      },
      "else": {
        "properties": {
          "memory_id": {
            "type": "string",
            "format": "uuid"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yixumemory.invalid/private/m2/write.schema.json"
}
