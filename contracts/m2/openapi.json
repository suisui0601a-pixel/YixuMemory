{
  "openapi": "3.1.0",
  "info": {
    "title": "YixuMemory M2 private metadata contract",
    "version": "0.0.0-m2-design",
    "description": "Local private prototype ONLY. No network server or public authentication. Profile is a contract marker, never permission to enable a backend. NoContentRuntime remains unavailable. Path/body targets must agree; server AuthContext is authoritative. Existing P0 wire v1 unchanged."
  },
  "paths": {
    "/m2/tenants/{tenant_id}/spaces/{space_id}/memory/temporal": {
      "parameters": [
        {
          "name": "tenant_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "space_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "writeTemporal",
        "x-required-capability": "memory.append or memory.revise selected by operation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Write"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Design result shape; local Rust adapter only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryReceipt"
                }
              }
            }
          },
          "403": {
            "description": "Denied scope or live authority"
          },
          "409": {
            "description": "CAS, invalid cursor, state or integrity error; no output"
          },
          "503": {
            "description": "Capability/budget/backend unavailable"
          }
        }
      }
    },
