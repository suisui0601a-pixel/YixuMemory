{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yixumemory.org/schemas/v1/event.schema.json",
  "title": "Event",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "space_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "raw_event",
        "external_document",
        "user_statement",
        "system_action"
      ]
    },
    "payload_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "actor_id": {
      "type": "string",
      "format": "uuid"
    },
    "knowledge_seq": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "schema_version",
    "id",
    "tenant_id",
    "space_id",
    "kind",
    "payload_id",
    "occurred_at",
    "recorded_at",
    "actor_id",
    "knowledge_seq"
  ]
}
