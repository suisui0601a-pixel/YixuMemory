{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yixumemory.org/schemas/v1/revision.schema.json",
  "title": "Revision",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "space_id": {
      "type": "string",
      "format": "uuid"
    },
    "memory_id": {
      "type": "string",
      "format": "uuid"
    },
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "parent_revision_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "assertion_kind": {
      "enum": [
        "extracted_fact",
        "model_inference",
        "fictional_setting",
        "user_assertion"
      ]
    },
    "content_payload_id": {
      "type": "string",
      "format": "uuid"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "valid_to": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "knowledge_seq": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "schema_version",
    "id",
    "tenant_id",
    "space_id",
    "memory_id",
    "number",
    "parent_revision_id",
    "assertion_kind",
    "content_payload_id",
    "valid_from",
    "valid_to",
    "recorded_at",
    "evidence_ids",
    "knowledge_seq"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "number": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "parent_revision_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "parent_revision_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  ]
}
