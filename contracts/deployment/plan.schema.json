{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yixumemory.org/contracts/deployment/v1/plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "plan_id": {
      "type": "string",
      "format": "uuid"
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "instance_id": {
      "type": "string",
      "format": "uuid"
    },
    "host_id": {
      "type": "string",
      "minLength": 1
    },
    "config_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "preflight_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target_version": {
      "type": "string",
      "minLength": 1
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "identity_ref": {
      "type": "string",
      "minLength": 1
    },
    "preserve_existing_data": {
      "const": true
    },
    "path_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "absolute_path": {
            "type": "string",
            "minLength": 1
          },
          "preimage_digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "owned": {
            "type": "boolean"
          }
        },
        "required": [
          "ref",
          "absolute_path",
          "preimage_digest",
          "owned"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "create_directories",
              "write_config",
              "provision_secret_ref",
              "install_artifact",
              "start_service",
              "register_service",
              "configure_proxy",
              "configure_firewall",
              "create_backup",
              "restore_backup",
              "migrate_schema",
              "rotate_client_credential",
              "rotate_payload_key",
              "write_client_config",
              "synthetic_verify",
              "stop_service",
              "verify_backup"
            ]
          },
          "target_ref": {
            "type": "string",
            "minLength": 1
          },
          "required_scopes": {
            "type": "array",
            "items": {
              "enum": [
                "filesystem.create",
                "config.write",
                "secrets.provision",
                "artifact.install",
                "service.start",
                "service.register",
                "network.expose",
                "backup.create",
                "backup.restore",
                "schema.migrate",
                "credentials.rotate",
                "keys.rotate",
                "client.config.write",
                "synthetic.write",
                "service.stop",
                "backup.verify"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "requires_elevation": {
            "type": "boolean"
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128
          }
        },
        "required": [
          "id",
          "kind",
          "target_ref",
          "required_scopes",
          "requires_elevation",
          "idempotency_key"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "upgrade": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "backup_verified": {
          "type": "boolean"
        },
        "restore_drill_verified": {
          "type": "boolean"
        },
        "migration_compatible": {
          "type": "boolean"
        },
        "deletion_watermark_verified": {
          "type": "boolean"
        }
      },
      "required": [
        "required",
        "backup_verified",
        "restore_drill_verified",
        "migration_compatible",
        "deletion_watermark_verified"
      ]
    }
  },
  "required": [
    "contract_version",
    "plan_id",
    "plan_hash",
    "instance_id",
    "host_id",
    "config_digest",
    "preflight_digest",
    "artifact_digest",
    "target_version",
    "valid_until",
    "identity_ref",
    "preserve_existing_data",
    "path_bindings",
    "actions",
    "upgrade"
  ]
}
